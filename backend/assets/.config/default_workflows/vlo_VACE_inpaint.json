      "properties": {
        "widget_ue_connectable": {}
      },
      "widgets_values": [
        "For simplicity, we use two videos instead of just passing the alpha and extracting because sometimes we might want the underlying pixels to be retained. Most video encoding premultiplies alpha, crushing whatever would be 'below' the alpha, so we need two videos.\n\nEven if we are able to use straight alpha, there is a precision question; if we have two videos the mask video can efficiently be made lossless, so the additional overhead is small. "
      ],
      "widgets_values_named": {
        "text": "For simplicity, we use two videos instead of just passing the alpha and extracting because sometimes we might want the underlying pixels to be retained. Most video encoding premultiplies alpha, crushing whatever would be 'below' the alpha, so we need two videos.\n\nEven if we are able to use straight alpha, there is a precision question; if we have two videos the mask video can efficiently be made lossless, so the additional overhead is small. "
      },
      "color": "#432",
      "bgcolor": "#653"
